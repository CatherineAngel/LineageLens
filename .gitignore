# and scripts/build.mjs (extension). Never commit the 13-15 MB copy.
public/pyodide/
vscode-extension/vendor/

# ---- python ----
.venv/
.venv-*/
__pycache__/
*.pyc
*.pyo

# ---- scratch ----
.spike/
.probe*

# ---- editor & OS ----
.DS_Store
.idea/
*.swp
*.log

# ---- local tooling (per-developer, not shared) ----
.commandcode/
